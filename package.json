{
  "name": "sinbod-wayne-productions",
  "version": "0.1.0",
  "private": true,
  "description": "Sinbod Wayne Productions pre-production studio",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @swp/web",
    "db:migrate:local": "npm run db:migrate:local --workspace @swp/web",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @swp/web",
    "bootstrap:local": "npm run bootstrap:local --workspace @swp/web",
    "bootstrap:remote": "npm run bootstrap:remote --workspace @swp/web",
    "seed": "npm run seed --workspace @swp/web",
    "seed:test": "npm run seed:test --workspace @swp/web",
    "seed:local": "npm run seed:local --workspace @swp/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @swp/web",
    "test:migrations": "npm run test:migrations --workspace @swp/web",
    "test:e2e": "npm run test:e2e --workspace @swp/web",
    "test": "npm run test:unit && npm run test:integration",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:migrations && npm run build && npm run test:e2e",
    "deploy": "npm run deploy --workspace @swp/web",
    "types:worker": "npm run types:worker --workspace @swp/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
