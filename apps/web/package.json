{
  "name": "@swp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "test:migrations": "vitest run --config vitest.config.ts src/server/db/schema.smoke.test.ts src/server/shares/external-approval-schema.test.ts",
    "test:e2e": "playwright test",
    "types:worker": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply sinbod-wayne-productions-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sinbod-wayne-productions-db --remote",
    "bootstrap:local": "tsx scripts/bootstrap.ts --target local",
    "bootstrap:remote": "tsx scripts/bootstrap.ts --target production",
    "seed": "npm run seed:test",
    "seed:test": "tsx scripts/seed.ts --target test",
    "seed:local": "tsx scripts/seed.ts --target local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/courier-prime": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@swp/domain": "0.1.0",
    "@swp/ui": "0.1.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.18",
    "dexie": "4.4.4",
    "dompurify": "3.4.13",
    "drizzle-orm": "0.45.2",
    "hash-wasm": "4.12.0",
    "hono": "4.13.1",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260808.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/dompurify": "3.2.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.11.2",
    "tsx": "4.21.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
