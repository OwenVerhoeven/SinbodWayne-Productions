    "start": "node ./dist/index.js",
    "test": "node --test --experimental-strip-types ./test/archive-agent.test.ts",
    "test:unit": "npm run test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
