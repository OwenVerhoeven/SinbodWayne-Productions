{
  "name": "@swp/nas-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound-only, checksummed archive pull agent for Sinbod Wayne Productions",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "swp-nas-agent": "./dist/index.js"
  },
  "scripts": {
